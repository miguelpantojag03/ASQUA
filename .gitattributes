# Normaliza finales de línea y trata los assets de Unity como texto fusionable
* text=auto
*.cs diff=csharp text
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.mat text eol=lf
*.png binary
*.ttf binary
*.otf binary
