  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_mina_brasa_completada
  m_EditorClassIdentifier: 
  dialogueId: mina_brasa_completada
  lines:
  - speaker: Mina
    text: "\xA1Brasa! \u2026Est\xE1 tibia. Est\xE1 bien."
  - speaker: Mina
    text: "Pens\xE9 que se hab\xEDa ido con todo lo dem\xE1s. Con las ventanas, con
      la gente."
  - speaker: Ilse
    text: "Las cosas peque\xF1as tambi\xE9n saben volver."
  - speaker: Mina
    text: "Entonces yo tambi\xE9n me quedo. Mientras haya una chispa, la plaza no
      est\xE1 vac\xEDa."
  - speaker: Mina
    text: Toma. Brasa quiere que te lleves un poco de su calor.
  choices: []
