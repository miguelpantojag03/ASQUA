  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_teo_postal_oferta
  m_EditorClassIdentifier: 
  dialogueId: teo_postal_oferta
  lines:
  - speaker: Teo
    text: "Mira lo que apareci\xF3 entre mis cajas: una postal. Es de la abuela de
      Mina, conozco esa letra."
  - speaker: Teo
    text: "Siempre le escrib\xEDa desde el puerto, aunque vivieran a dos calles."
  - speaker: Teo
    text: "Yo ya no llego hasta la plaza con estas rodillas. \xBFSe la llevas t\xFA?"
  - speaker: Ilse
    text: "Claro. \xBFD\xF3nde est\xE1?"
  - speaker: Teo
    text: "Sobre el mostrador de mi puesto. C\xF3gela con cuidado, que el papel ya
      no aguanta mucho."
  choices:
  - label: "Se la llevar\xE9"
    action: 1
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
  - label: Ahora no
    action: 2
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
