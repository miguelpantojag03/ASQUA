  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_teo_velas_reserva_oferta
  m_EditorClassIdentifier: 
  dialogueId: teo_velas_reserva_oferta
  lines:
  - speaker: Teo
    text: Me quedan seis velas de reserva. Las buenas, las de cera de verdad.
  - speaker: Teo
    text: "Podr\xEDa guardarlas aqu\xED, en el mercado, para cuando la noche apriete
      de verdad."
  - speaker: Teo
    text: "O podr\xEDas llev\xE1rselas a la Casa de ancianos. Perpetua y los dem\xE1s
      pasan las noches a oscuras y no se quejan nunca."
  - speaker: Teo
    text: "Decide t\xFA. Yo ya no s\xE9 qu\xE9 es lo justo."
  choices:
  - label: "Gu\xE1rdalas en el Mercado"
    action: 3
    hopeDelta: 5
    hopeZoneId: Mercado
    energyDelta: 0
    bondDelta: 0
    toast: "Teo guarda las velas de reserva en el Mercado. Alg\xFAn d\xEDa har\xE1n
      falta."
    setFlag: velas_mercado
  - label: "Ll\xE9valas a la Casa de ancianos"
    action: 3
    hopeDelta: 5
    hopeZoneId: Plaza
    energyDelta: 0
    bondDelta: 0
    toast: "Las velas de reserva ir\xE1n a las ventanas de la Casa de ancianos."
    setFlag: velas_casa
