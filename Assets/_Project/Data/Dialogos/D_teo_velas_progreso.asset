  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_teo_velas_progreso
  m_EditorClassIdentifier: 
  dialogueId: teo_velas_progreso
  lines:
  - speaker: Teo
    text: "\xA1M\xE1s luz, que no veo d\xF3nde pongo la mecha!"
  - speaker: Teo
    text: Cada puesto encendido es una casa que se acuerda de abrir la ventana.
  - speaker: Ilse
    text: Aguanta, Teo. No me voy.
  - speaker: Teo
    text: "Yo tampoco me voy a ning\xFAn lado. Este es mi sitio."
  choices: []
