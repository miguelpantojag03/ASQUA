  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_teo_velas_completada
  m_EditorClassIdentifier: 
  dialogueId: teo_velas_completada
  lines:
  - speaker: Teo
    text: "Mira eso. Velas en todos los puestos. Hasta en el de la se\xF1ora Amparo,
      que ya no viene."
  - speaker: Teo
    text: No es mucho. Pero se ve desde las ventanas, y eso basta para que alguien
      no cierre la suya.
  - speaker: Ilse
    text: Se ve desde muy lejos, Teo.
  - speaker: Teo
    text: 'Pues que se vea. Toma, para tu farol: las velas y los faroles somos familia.'
  - speaker: Teo
    text: "Si alguna noche vuelves, aqu\xED habr\xE1 luz. Palabra de Bravo."
  choices: []
