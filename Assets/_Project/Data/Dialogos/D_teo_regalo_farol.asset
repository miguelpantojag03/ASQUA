  m_Name: D_teo_regalo_farol
  m_EditorClassIdentifier: 
  dialogueId: teo_regalo_farol
  lines:
  - speaker: Teo
    text: "Espera, no te vayas todav\xEDa. Tengo algo para ti."
  - speaker: Teo
    text: Era del farol de mi padre. El cristal grande, el de las noches de temporal.
  - speaker: Teo
    text: "Yo ya no salgo a alumbrar a nadie. Pero t\xFA s\xED."
  - speaker: Ilse
    text: "Pesa\u2026 y brilla distinto."
  - speaker: Teo
    text: "As\xED se ve m\xE1s lejos. \xDAsalo cuando la noche apriete."
  choices: []
