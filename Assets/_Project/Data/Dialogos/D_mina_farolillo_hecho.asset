  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_mina_farolillo_hecho
  m_EditorClassIdentifier: 
  dialogueId: mina_farolillo_hecho
  lines:
  - speaker: Mina
    text: "\xA1Es este! Mira el p\xE1jaro\u2026 est\xE1 un poco borrado, pero es
      \xE9l."
  - speaker: Mina
    text: "Por dentro hay algo escrito. \xABPara que la tuya no se apague nunca.
      \u2014 C.\xBB"
  - speaker: Ilse
    text: "\xBFC.? \xBFQui\xE9n era?"
  - speaker: Mina
    text: "No lo s\xE9. Pap\xE1 nunca dec\xEDa su nombre. Dec\xEDa que ten\xEDa nombre
      de p\xE1jaro\u2026 y que un d\xEDa se cans\xF3 de que nadie le diera las gracias."
  - speaker: Mina
    text: "Despu\xE9s dej\xF3 de venir. Y los faroles del callej\xF3n se fueron apagando
      uno a uno."
  - speaker: Mina
    text: "Gracias, Ilse. Ahora ya s\xE9 d\xF3nde poner a Brasa cuando tenga fr\xEDo."
  choices: []
