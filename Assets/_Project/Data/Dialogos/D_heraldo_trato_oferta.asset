  m_Name: D_heraldo_trato_oferta
  m_EditorClassIdentifier: 
  dialogueId: heraldo_trato_oferta
  lines:
  - speaker: El Heraldo
    text: "Llevas mucho peso para ser solo un recuerdo, peque\xF1a luz."
  - speaker: El Heraldo
    text: "Te veo correr de una calle a otra. Apag\xE1ndote un poco en cada esquina."
  - speaker: El Heraldo
    text: Puedo darte lo que te falta. Luz entera, ahora mismo.
  - speaker: El Heraldo
    text: "A cambio, el mercado duerme un poco antes. Nadie lo notar\xE1. Ya casi
      no queda nadie."
  choices:
  - label: Acepto el trato
    action: 3
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: "Trato aceptado \xB7 El Mercado pierde Esperanza"
  - label: No. Ese mercado no es tuyo.
    action: 2
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
