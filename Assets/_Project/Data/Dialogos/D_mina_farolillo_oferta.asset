  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_mina_farolillo_oferta
  m_EditorClassIdentifier: 
  dialogueId: mina_farolillo_oferta
  lines:
  - speaker: Mina
    text: "\xBFPuedo pedirte una cosa que no es urgente? Bueno\u2026 para m\xED s\xED
      lo es."
  - speaker: Mina
    text: "Mi pap\xE1 ten\xEDa un farolillo de papel. Rojo, con un p\xE1jaro negro
      pintado en un lado."
  - speaker: Mina
    text: "Se lo regal\xF3 un amigo suyo, otro farolero. Pap\xE1 dec\xEDa que nadie
      doblaba el papel como \xE9l."
  - speaker: Ilse
    text: "\xBFD\xF3nde lo perdi\xF3?"
  - speaker: Mina
    text: "Lo colgaba en el callej\xF3n de los faroleros, detr\xE1s de la plaza.
      Pero hace mucho que no voy. All\xED est\xE1 muy oscuro."
  choices:
  - label: "Lo buscar\xE9 en el callej\xF3n"
    action: 1
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
    setFlag: 
  - label: Ahora no
    action: 2
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
    setFlag: 
