  m_Name: D_mina_brasa_oferta
  m_EditorClassIdentifier: 
  dialogueId: mina_brasa_oferta
  lines:
  - speaker: Mina
    text: "\xBFT\xFA tambi\xE9n llevas luz? Entonces quiz\xE1 puedas ayudarme."
  - speaker: Mina
    text: "Brasa se escap\xF3 cuando se apag\xF3 la \xFAltima farola de la plaza."
  - speaker: Mina
    text: "Es peque\xF1ita. Una chispa que cabe en las manos\u2026 y que siempre
      va detr\xE1s de las luci\xE9rnagas."
  - speaker: Ilse
    text: "Si junto algunas, \xBFvendr\xE1 sigui\xE9ndolas?"
  - speaker: Mina
    text: "Con tres, seguro. Sola le da miedo la oscuridad. Como a m\xED."
  choices:
  - label: "Las buscar\xE9"
    action: 1
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
  - label: Ahora no puedo
    action: 2
