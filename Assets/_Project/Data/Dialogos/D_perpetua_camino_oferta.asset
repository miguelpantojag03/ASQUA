  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_perpetua_camino_oferta
  m_EditorClassIdentifier: 
  dialogueId: perpetua_camino_oferta
  lines:
  - speaker: Perpetua
    text: "Ay, criatura. Baj\xE9 por pan y se me hizo de noche sin darme cuenta.
      Como siempre."
  - speaker: Perpetua
    text: "La Casa de ancianos est\xE1 al otro lado de la plaza. Sola no llego: la
      oscuridad me confunde las calles."
  - speaker: Perpetua
    text: "Pero no gastes tu luz en m\xED, \xBFeh? Con un poquito basta. Yo veo con
      poco."
  - speaker: Ilse
    text: "Te acompa\xF1o. Con poquito."
  choices:
  - label: Vamos, despacio
    action: 1
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
    setFlag: 
  - label: Espera un momento
    action: 2
