  m_Name: D_mina_malecon_completada
  m_EditorClassIdentifier: 
  dialogueId: mina_malecon_completada
  lines:
  - speaker: Mina
    text: "Mira, Brasa. Ah\xED est\xE1. Todo negro, pero se mueve. Respira."
  - speaker: Mina
    text: "La abuela ten\xEDa raz\xF3n: hay luces dentro. Peque\xF1itas. Muy lejos."
  - speaker: Ilse
    text: "Son las que todav\xEDa no se apagaron."
  - speaker: Mina
    text: "Entonces vamos a cuidarlas. T\xFA las de arriba, yo las de aqu\xED."
  - speaker: Mina
    text: Gracias por caminar conmigo. Ya no me da tanto miedo volver.
  choices: []
