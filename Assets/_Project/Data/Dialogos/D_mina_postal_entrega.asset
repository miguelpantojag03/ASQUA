  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_mina_postal_entrega
  m_EditorClassIdentifier: 
  dialogueId: mina_postal_entrega
  lines:
  - speaker: Mina
    text: "\xBFUna postal? \u2026Es su letra. \xABPara mi chispa: hoy el mar estaba
      de buen humor.\xBB"
  - speaker: Mina
    text: "Me llamaba as\xED. Chispa. Por eso Brasa se llama Brasa."
  - speaker: Ilse
    text: "Teo la guard\xF3 todo este tiempo."
  - speaker: Mina
    text: "Dale las gracias. No\u2026 mejor se las doy yo. Ma\xF1ana. Si hay ma\xF1ana."
  choices: []
