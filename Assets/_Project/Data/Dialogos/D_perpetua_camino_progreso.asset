  dialogueId: perpetua_camino_progreso
  lines:
  - speaker: Perpetua
    text: "Despacio, criatura. A mi edad cada adoqu\xEDn es una monta\xF1a."
  - speaker: Perpetua
    text: Y no enciendas tanto ese farol, que me deslumbras y te cansas.
