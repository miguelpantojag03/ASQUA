  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_perpetua_camino_hecho
  m_EditorClassIdentifier: 
  dialogueId: perpetua_camino_hecho
  lines:
  - speaker: Perpetua
    text: 'Ya estamos. Mira mi ventana: la de las cortinas de flores.'
  - speaker: Perpetua
    text: "Mi Ram\xF3n tambi\xE9n sal\xEDa de noche con la luz por delante. Ten\xEDa
      tu misma manera de andar."
  - speaker: Ilse
    text: "\xBFEra farolero?"
  - speaker: Perpetua
    text: "Era muchas cosas, criatura. Pero s\xED\u2026 tambi\xE9n eso."
  choices: []
