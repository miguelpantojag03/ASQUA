  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_heraldo_revela_3
  m_EditorClassIdentifier: 
  dialogueId: heraldo_revela_3
  lines:
  - speaker: El Heraldo
    text: "La voz que recuerdas te pidi\xF3 que alumbraras. No te dijo hasta cu\xE1ndo."
  - speaker: El Heraldo
    text: "Cuando la ciudad entera te olvide, \xBFqui\xE9n quedar\xE1 para recordarte
      a ti?"
  - speaker: Ilse
    text: "Mina. Teo. Las ventanas que encend\xED. Eso queda."
  choices: []
