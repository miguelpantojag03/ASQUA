  dialogueId: mina_ninguna_oferta
  lines:
  - speaker: Mina
    text: "El viento ha apagado dos farolas de la plaza. Si cae otra, ya no ver\xE9
      la fuente desde mi ventana."
  - speaker: Mina
    text: "Y Teo\u2026 he o\xEDdo ruido en el mercado. Sombras."
  - speaker: Mina
    text: "No puedo pedirte que elijas. As\xED que no elijas, \xBFvale?"
  choices:
  - label: 'No elijo: las dos'
    action: 1
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
    bondDelta: 0
    toast: 
    setFlag: 
  - label: Ahora no
    action: 2
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 0
