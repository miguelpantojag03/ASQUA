  dialogueId: teo_todavia_sirvo_progreso_nerviosa
  lines:
  - speaker: Teo
    text: "\xA1Se me tuerce la mecha y el mercado se oscurece! No te vayas, Ilse,
      que solo no llego\u2026"
  - speaker: Ilse
    text: No me voy. Sigue. Te estoy viendo.
