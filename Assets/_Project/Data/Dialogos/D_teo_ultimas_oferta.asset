  m_Name: D_teo_ultimas_oferta
  m_EditorClassIdentifier: 
  dialogueId: teo_ultimas_oferta
  lines:
  - speaker: Teo
    text: "Me quedan las tres \xFAltimas velas. Las buenas, las de cera de verdad."
  - speaker: Teo
    text: "La plaza est\xE1 m\xE1s sola que nunca. Pero el mercado es lo \xFAltimo
      que le queda a este barrio."
  - speaker: Teo
    text: "T\xFA has visto las dos cosas esta noche. Decide t\xFA."
  choices:
  - label: "Ll\xE9valas a La Plaza"
    action: 3
    hopeDelta: 18
    hopeZoneId: Plaza
    energyDelta: 0
    bondDelta: 0
    toast: "Teo llev\xF3 sus \xFAltimas velas a La Plaza"
  - label: Que se queden en el Mercado
    action: 3
    hopeDelta: 18
    hopeZoneId: Mercado
    energyDelta: 0
    bondDelta: 0
    toast: "Las \xFAltimas velas se quedan en El Mercado"
  - label: "Gu\xE1rdalas para otra noche"
    action: 3
    hopeDelta: 0
    hopeZoneId: 
    energyDelta: 25
    bondDelta: 0
    toast: "Teo te guarda las velas \xB7 +25 de energ\xEDa"
