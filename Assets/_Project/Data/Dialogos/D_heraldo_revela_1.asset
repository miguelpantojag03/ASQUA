  dialogueId: heraldo_revela_1
  lines:
  - speaker: El Heraldo
    text: "Tu luz quema, peque\xF1a luz. Como la suya."
  - speaker: El Heraldo
    text: "\xC9l tambi\xE9n encend\xEDa faroles en esta ciudad. Y tambi\xE9n acab\xF3
      cans\xE1ndose."
  - speaker: Ilse
    text: "\xBFQui\xE9n? \xBFDe qui\xE9n hablas?"
