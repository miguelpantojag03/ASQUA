  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_teo_todavia_sirvo_hecho
  m_EditorClassIdentifier: 
  dialogueId: teo_todavia_sirvo_hecho
  lines:
  - speaker: Teo
    text: "Ah\xED est\xE1. El farol de los Bravo, encendido otra vez."
  - speaker: Teo
    text: "Me temblaban las manos, \xBFlo has visto? Cuarenta a\xF1os y me temblaban
      como el primer d\xEDa."
  - speaker: Ilse
    text: "Lo he visto todo, Teo. Lo has encendido t\xFA."
  - speaker: Teo
    text: "\u2026Gracias por no hacerlo por m\xED. Eso es lo que m\xE1s necesitaba."
  - speaker: Teo
    text: Toma. Un farolero siempre comparte la primera luz de la noche.
  choices: []
