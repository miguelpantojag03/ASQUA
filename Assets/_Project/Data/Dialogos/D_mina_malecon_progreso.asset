  m_Script: {fileID: 11500000, guid: a88d24fd4be5b8b47a4cf23ae78f10ec, type: 3}
  m_Name: D_mina_malecon_progreso
  m_EditorClassIdentifier: 
  dialogueId: mina_malecon_progreso
  lines:
  - speaker: Mina
    text: No te alejes, por favor. Contigo la niebla no se acerca tanto.
  - speaker: Mina
    text: "Brasa lo va mirando todo. Creo que nunca hab\xEDa salido de la plaza."
  - speaker: Ilse
    text: Ya casi. Se oye el agua.
  - speaker: Mina
    text: "S\xED\u2026 se oye."
  choices: []
