  night: 2
  atProgress: 0.5
  forceAtProgress: 0.8
  omenRoot: {fileID: 1659060159}
  omenLight: {fileID: 1608221708}
  omenGlow: {fileID: 517316674}
  lightIntensity: 9
  spots:
  - {fileID: 1451398297}
  - {fileID: 491544040}
  - {fileID: 8927465}
  omenCamera: {fileID: 2140598585}
  thoughtGroup: {fileID: 591202075}
  thoughtText: {fileID: 1517429648}
  hudGroup: {fileID: 619345818}
  cameraSeconds: 6
  duration: 14.5
  thoughts:
  - at: 0.8
    text: "All\xED, sobre los tejados del norte\u2026 alguien ha encendido un farol."
    hold: 3.2
  - at: 4.2
    text: Pero esa luz no calienta. Es violeta, como la suya.
    hold: 3
  - at: 7.4
    text: '[Un susurro lejano, sin palabras]'
    hold: 2
  - at: 9.6
    text: "\xBFPor qu\xE9 iba a encender un farol quien quiere que todo se apague?"
    hold: 2.4
  - at: 12.1
    text: "Se ha ido. Y tengo fr\xEDo, como si hubiera olvidado algo importante."
    hold: 2.3
  diaryPageId: pagina_04
