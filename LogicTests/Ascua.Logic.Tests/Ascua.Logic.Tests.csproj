<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Corre con `dotnet test` las mismas pruebas EditMode que ve el Test Runner de Unity
    (Assets/_Project/Tests/EditMode). NUnit 3, como el com.unity.test-framework.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: los nombres de prueba usan Contexto_Caso_Resultado, como en el resto del repo.
         CA1861: en una prueba, un arreglo literal es más legible que un campo static readonly.
         CA2263: Enum.GetValues<T>() no existe en el .NET Standard 2.1 de Unity; las pruebas EditMode
         también compilan allá, así que se mantiene Enum.GetValues(typeof(T)). -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2263</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AscuaTests)EditMode/**/*.cs" Link="EditMode/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="UnityShims/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ascua.LevelGen/Ascua.LevelGen.csproj" />
    <ProjectReference Include="../Ascua.Endings/Ascua.Endings.csproj" />
    <ProjectReference Include="../Ascua.Recuerdos/Ascua.Recuerdos.csproj" />
  </ItemGroup>
</Project>
